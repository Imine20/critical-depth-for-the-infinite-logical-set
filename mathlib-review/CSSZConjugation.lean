import CSSComputationalMonomial

/-!
# Transport of the algebra generated by CSS Z checks

If unitary conjugation maps each generator into its algebra, the induced
map is onto that algebra by finite-dimensionality. Conjugation then
preserves its centralizer.
-/

namespace CriticalDepth.Manuscript20261114.CSSZConjugation

open CriticalDepth.Manuscript

variable {ι : Type*} [Fintype ι] [DecidableEq ι]

/-- In finite-dimensional matrix algebra, closure under the image of the
generators implies equality of the entire image and generated algebra. -/
theorem adjoin_map_eq_of_maps_generators
    (e : Operator ι ≃ₐ[ℂ] Operator ι) (generators : Set (Operator ι))
    (hgen : ∀ A ∈ generators, e A ∈ Algebra.adjoin ℂ generators) :
    (Algebra.adjoin ℂ generators).map e.toAlgHom = Algebra.adjoin ℂ generators := by
  let D := Algebra.adjoin ℂ generators
  have hle : D.map e.toAlgHom ≤ D := by
    change (Algebra.adjoin ℂ generators).map e.toAlgHom ≤ D
    rw [AlgHom.map_adjoin]
    apply Algebra.adjoin_le
    rintro _ ⟨A, hA, rfl⟩
    exact hgen A hA
  have hd : (D.map e.toAlgHom).toSubmodule = D.toSubmodule :=
    Submodule.eq_of_le_of_finrank_le hle (by
      rw [Subalgebra.map_toSubmodule]
      exact (LinearEquiv.finrank_map_eq e.toLinearEquiv D.toSubmodule).symm.le)
  exact SetLike.coe_injective (congrArg (fun M : Submodule ℂ (Operator ι) =>
    (M : Set (Operator ι))) hd)

/-- An algebra automorphism mapping the generators into their own algebra
also preserves the operators commuting with each generator. -/
theorem commutes_adjoin_of_maps_generators
    (e : Operator ι ≃ₐ[ℂ] Operator ι) (generators : Set (Operator ι))
    (hgen : ∀ A ∈ generators, e A ∈ Algebra.adjoin ℂ generators)
    (O : Operator ι) (hO : ∀ A ∈ generators, A * O = O * A) :
    ∀ A ∈ Algebra.adjoin ℂ generators, A * e O = e O * A := by
  let D := Algebra.adjoin ℂ generators
  have hMem : O ∈ Subalgebra.centralizer ℂ generators :=
    (Subalgebra.mem_centralizer_iff ℂ).mpr hO
  have hAll (A : Operator ι) (hA : A ∈ D) : A * O = O * A := by
    have hcentral := Algebra.adjoin_le_centralizer_centralizer (R := ℂ) generators hA
    exact (((Subalgebra.mem_centralizer_iff ℂ).mp hcentral) O hMem).symm
  intro A hA
  have hm : A ∈ D.map e.toAlgHom := by
    rw [show D.map e.toAlgHom = D from adjoin_map_eq_of_maps_generators e generators hgen]
    exact hA
  obtain ⟨B, hB, hBA⟩ := Subalgebra.mem_map.mp hm
  change e B = A at hBA
  rw [← hBA, ← map_mul, ← map_mul, hAll B hB]

/-- If the logical action of U is implemented on the encoding, then a
code-preserving operator remains code preserving after conjugation by U. -/
theorem conjugation_preserves_encoded_space {n k : ℕ}
    (C : Code n (fun _ => 2) (2 ^ k) 1)
    (U O : Operator (QubitBasis n))
    (hU : IsUnitary U)
    (W F : Operator (Fin (2 ^ k) × Fin 1))
    (hW : IsUnitary W)
    (hImpl : U * C.encoding = C.encoding * W)
    (hO : O * C.encoding = C.encoding * F) :
    (U * O * U.conjTranspose) * C.encoding = C.encoding * (W * F * W.conjTranspose) := by
  have hUd : U.conjTranspose * U = 1 := hU.1
  have hWd : W * W.conjTranspose = 1 := hW.2
  have hInv : U.conjTranspose * C.encoding = C.encoding * W.conjTranspose := by
    calc
      U.conjTranspose * C.encoding =
          U.conjTranspose * ((C.encoding * W) * W.conjTranspose) := by
        rw [Matrix.mul_assoc C.encoding, hWd, Matrix.mul_one]
      _ = C.encoding * W.conjTranspose := by
        rw [← hImpl, ← Matrix.mul_assoc, ← Matrix.mul_assoc, hUd, Matrix.one_mul]
  calc
    _ = U * (O * (U.conjTranspose * C.encoding)) := by
      simp only [Matrix.mul_assoc]
    _ = U * ((O * C.encoding) * W.conjTranspose) := by rw [hInv, Matrix.mul_assoc]
    _ = U * ((C.encoding * F) * W.conjTranspose) := by rw [hO]
    _ = C.encoding * (W * F * W.conjTranspose) := by
      rw [← Matrix.mul_assoc, ← Matrix.mul_assoc, hImpl]
      simp only [Matrix.mul_assoc]

/-- The diagonal-conjugate criterion is inherited from the centralizer
when the relevant supported members of that centralizer are diagonal. -/
theorem singleSiteZ_conjugates_diagonal
    {n : ℕ} (u : Matrix.unitaryGroup (QubitBasis n) ℂ)
    (generators : Set (Operator (QubitBasis n)))
    (hgen : ∀ A ∈ generators,
      u.val * A * u.val.conjTranspose ∈ Algebra.adjoin ℂ generators)
    (hcomm : ∀ i : Fin n, ∀ A ∈ generators, A * pauliMatrix 0 (singleSitePauli i .Z) =
      pauliMatrix 0 (singleSitePauli i .Z) * A)
    (R : ℕ) (hSupport : ∀ i : Fin n, ∃ A : Finset (Fin n), A.card ≤ R ∧
      SupportedOn (u.val * pauliMatrix 0 (singleSitePauli i .Z) * u.val.conjTranspose) A)
    (hDiagonal : ∀ (O : Operator (QubitBasis n)) (A : Finset (Fin n)), A.card ≤ R →
      SupportedOn O A → (∀ B ∈ Algebra.adjoin ℂ generators, B * O = O * B) →
      ∀ x y : QubitBasis n, x ≠ y → O x y = 0) :
    ∀ (i : Fin n) (x y : QubitBasis n), x ≠ y →
      (u.val * pauliMatrix 0 (singleSitePauli i .Z) * u.val.conjTranspose) x y = 0 := by
  intro i x y hxy
  let e : Operator (QubitBasis n) ≃ₐ[ℂ] Operator (QubitBasis n) :=
    (Unitary.conjStarAlgAut ℂ (Operator (QubitBasis n)) u).toAlgEquiv
  have he (A : Operator (QubitBasis n)) : e A = u.val * A * u.val.conjTranspose := rfl
  obtain ⟨A, hA, hs⟩ := hSupport i
  refine hDiagonal _ A hA hs ?_ x y hxy
  simpa only [he] using commutes_adjoin_of_maps_generators e generators
    (fun G hG => by rw [he]; exact hgen G hG)
    (pauliMatrix 0 (singleSitePauli i .Z)) (hcomm i)

#print axioms adjoin_map_eq_of_maps_generators
#print axioms commutes_adjoin_of_maps_generators
#print axioms conjugation_preserves_encoded_space
#print axioms singleSiteZ_conjugates_diagonal

end CriticalDepth.Manuscript20261114.CSSZConjugation
