import GenerationThresholds
import Mathlib.Analysis.Calculus.Deriv.Basic
import Mathlib.Analysis.Calculus.ContDiff.Operations
import Mathlib.Analysis.Calculus.ContDiff.RCLike
import Mathlib.Analysis.Calculus.InverseFunctionTheorem.FDeriv
import Mathlib.Analysis.Matrix.Normed
import Mathlib.Analysis.Normed.Ring.Units

/-!
# Neighborhoods generated by smooth unitary curves

If finitely many curves through the identity have derivatives spanning the
skew-Hermitian matrices over the reals, their subgroup contains an identity
neighborhood. We apply the real inverse function theorem in the ambient
matrix space, adding the Hermitian directions as an auxiliary factor on
the right of the curve product. For a unitary output, this auxiliary
factor is forced to equal the identity near the origin.
-/

namespace CriticalDepth.UnitaryCurveProducts

open CriticalDepth.ReviewV2
open Filter Set
open scoped Topology BigOperators Matrix.Norms.Frobenius

noncomputable section

variable {ι τ : Type*} [Fintype ι] [DecidableEq ι]

local notation "M" => Matrix ι ι ℂ
local notation "U" => Matrix.unitaryGroup ι ℂ

private def coordinateDerivative (X : τ → M) (i : τ) : (τ → ℝ) →L[ℝ] M :=
  (ContinuousLinearMap.proj i).smulRight (X i)

private def productDerivative (X : τ → M) : List τ → (τ → ℝ) →L[ℝ] M
  | [] => 0
  | i :: indices => coordinateDerivative X i + productDerivative X indices

private def curveProduct (c : τ → ℝ → U) (indices : List τ) (t : τ → ℝ) : U :=
  (indices.map fun i => c i (t i)).prod

private theorem coe_curveProduct (c : τ → ℝ → U) (indices : List τ) (t : τ → ℝ) :
    (curveProduct c indices t : M) = (indices.map fun i => (c i (t i) : M)).prod := by
  induction indices with
  | nil => rfl
  | cons i indices ih =>
    change (c i (t i) : M) * (curveProduct c indices t : M) =
      (c i (t i) : M) * (indices.map fun i => (c i (t i) : M)).prod
    rw [ih]

private theorem curveProduct_zero (c : τ → ℝ → U) (hc0 : ∀ i, c i 0 = 1)
    (indices : List τ) : curveProduct c indices 0 = 1 := by
  induction indices with
  | nil => rfl
  | cons i indices ih =>
    change c i 0 * curveProduct c indices 0 = 1
    rw [hc0, ih, mul_one]

private theorem curveProduct_hasFDerivAt [Fintype τ] (c : τ → ℝ → U) (hc0 : ∀ i, c i 0 = 1)
    (X : τ → M) (hDeriv : ∀ i, HasDerivAt (fun t => (c i t : M)) (X i) 0)
    (indices : List τ) :
    HasFDerivAt (fun t => (curveProduct c indices t : M)) (productDerivative X indices) 0 := by
  induction indices with
  | nil => exact hasFDerivAt_const 1 0
  | cons i indices ih =>
    let a : (τ → ℝ) →L[ℝ] ℝ := ContinuousLinearMap.proj i
    have hc : HasDerivAt (fun t => (c i t : M)) (X i) (a 0) := by
      simpa only [map_zero] using hDeriv i
    have hi : HasFDerivAt (fun t : τ → ℝ => (c i (t i) : M)) (coordinateDerivative X i) 0 :=
      (hc.hasFDerivAt.comp 0 a.hasFDerivAt).congr_fderiv (by
        apply ContinuousLinearMap.ext
        intro t
        rfl)
    change HasFDerivAt (fun t : τ → ℝ => (c i (t i) : M) *
      (curveProduct c indices t : M)) (productDerivative X (i :: indices)) 0
    exact (hi.mul' ih).congr_fderiv (by
      have hci : ((c i ((0 : τ → ℝ) i) : U) : M) = 1 :=
        congrArg (fun u : U => (u : M)) (hc0 i)
      have hcp : (curveProduct c indices 0 : M) = 1 :=
        congrArg (fun u : U => (u : M)) (curveProduct_zero c hc0 indices)
      rw [hci, hcp]
      apply ContinuousLinearMap.ext
      intro t
      change (1 : M) * productDerivative X indices t + coordinateDerivative X i t * 1 =
        coordinateDerivative X i t + productDerivative X indices t
      rw [one_mul, mul_one, add_comm])

private theorem curveProduct_contDiffAt [Fintype τ] (c : τ → ℝ → U)
    (hSmooth : ∀ i, ContDiffAt ℝ 1 (fun t => (c i t : M)) 0) (indices : List τ) :
    ContDiffAt ℝ 1 (fun t => (curveProduct c indices t : M)) 0 := by
  induction indices with
  | nil => exact contDiffAt_const
  | cons i indices ih =>
    let a : (τ → ℝ) →L[ℝ] ℝ := ContinuousLinearMap.proj i
    have hc : ContDiffAt ℝ 1 (fun t => (c i t : M)) (a 0) := by
      simpa only [map_zero] using hSmooth i
    have hi : ContDiffAt ℝ 1 (fun t : τ → ℝ => (c i (t i) : M)) 0 :=
      hc.comp 0 a.contDiff.contDiffAt
    change ContDiffAt ℝ 1 (fun t : τ → ℝ => (c i (t i) : M) *
      (curveProduct c indices t : M)) 0
    exact hi.mul ih

private theorem productDerivative_apply (X : τ → M) (indices : List τ) (t : τ → ℝ) :
    productDerivative X indices t = (indices.map fun i => t i • X i).sum := by
  induction indices with
  | nil => rfl
  | cons i indices ih => simp [productDerivative, coordinateDerivative, ih]

private theorem hermitian_eq_zero_of_unitary {P F : U} (B : M) (hB : star B = B)
    (hF : (F : M) = (P : M) * (1 + B)) (hUnit : IsUnit (2 + B)) : B = 0 := by
  have hP : star (P : M) * (P : M) = 1 := Unitary.star_mul_self_of_mem P.property
  have hSq : (1 + (B : M)) * (1 + (B : M)) = 1 := by
    calc
      (1 + (B : M)) * (1 + (B : M)) =
          star ((P : M) * (1 + (B : M))) * ((P : M) * (1 + (B : M))) := by
        rw [star_mul, star_add, star_one, hB]
        symm
        calc
          (1 + (B : M)) * star (P : M) * ((P : M) * (1 + (B : M))) =
              (1 + (B : M)) * (star (P : M) * (P : M)) * (1 + (B : M)) := by
            simp only [mul_assoc]
          _ = _ := by rw [hP, mul_one]
      _ = 1 := by
        rw [← hF]
        exact Unitary.star_mul_self_of_mem F.property
  apply hUnit.mul_right_cancel
  calc
    (B : M) * (2 + (B : M)) = (1 + (B : M)) * (1 + (B : M)) - 1 := by
      noncomm_ring
    _ = 0 * (2 + (B : M)) := by rw [hSq, sub_self, zero_mul]

private def hermitianPart : M →ₗ[ℝ] M :=
  (selfAdjoint.submodule ℝ M).subtype.comp (selfAdjointPart ℝ)

private def ambientProduct (P : (τ → ℝ) → U) (p : (τ → ℝ) × M) : M :=
  (P p.1 : M) * (1 + hermitianPart p.2)

private theorem productNeighborhood [Fintype τ] (G : Subgroup U)
    (P : (τ → ℝ) → U) (hP0 : P 0 = 1) (hPG : ∀ t, P t ∈ G)
    (L : (τ → ℝ) →L[ℝ] M)
    (hSmooth : ContDiffAt ℝ 1 (fun t => (P t : M)) 0)
    (hDeriv : HasFDerivAt (fun t => (P t : M)) L 0)
    (hL : skewAdjoint.submodule ℝ M ≤ L.range) :
    (G : Set U) ∈ 𝓝 1 := by
  haveI : CompleteSpace M := FiniteDimensional.complete ℝ M
  let L₁ : ((τ → ℝ) × M) →L[ℝ] (τ → ℝ) := ContinuousLinearMap.fst ℝ (τ → ℝ) M
  let L₂ : ((τ → ℝ) × M) →L[ℝ] M :=
    hermitianPart.toContinuousLinearMap.comp (ContinuousLinearMap.snd ℝ (τ → ℝ) M)
  have hL₂ : HasFDerivAt (fun p : (τ → ℝ) × M => (1 : M) + hermitianPart p.2) L₂ 0 := by
    exact L₂.hasFDerivAt.const_add (1 : M)
  have hFDeriv : HasFDerivAt (ambientProduct P) (L.comp L₁ + L₂) 0 := by
    have hAt : HasFDerivAt (fun t => (P t : M)) L (L₁ 0) := by
      simpa only [map_zero] using hDeriv
    have hleft : HasFDerivAt (fun p : (τ → ℝ) × M => (P p.1 : M)) (L.comp L₁) 0 :=
      hAt.comp (0 : (τ → ℝ) × M) L₁.hasFDerivAt
    exact (hleft.mul' hL₂).congr_fderiv (by
      have hc : ((P ((0 : (τ → ℝ) × M).1) : U) : M) = 1 :=
        congrArg (fun u : U => (u : M)) hP0
      rw [hc, show (1 : M) + hermitianPart ((0 : (τ → ℝ) × M).2) = 1 by simp]
      apply ContinuousLinearMap.ext
      intro p
      change (1 : M) * L₂ p + L (L₁ p) * 1 = L (L₁ p) + L₂ p
      rw [one_mul, mul_one, add_comm])
  have hFSmooth : ContDiffAt ℝ 1 (ambientProduct P) 0 := by
    have hAt : ContDiffAt ℝ 1 (fun t => (P t : M)) (L₁ 0) := by
      simpa only [map_zero] using hSmooth
    have hleft : ContDiffAt ℝ 1 (fun p : (τ → ℝ) × M => (P p.1 : M)) 0 :=
      hAt.comp 0 L₁.contDiff.contDiffAt
    have hright : ContDiffAt ℝ 1 (fun p : (τ → ℝ) × M => (1 : M) + hermitianPart p.2) 0 :=
      contDiffAt_const.add L₂.contDiff.contDiffAt
    exact hleft.mul hright
  have hSurj : (L.comp L₁ + L₂).range = ⊤ := by
    apply top_unique
    intro A _
    have hK : (skewAdjointPart ℝ A : M) ∈ L.range :=
      hL (skewAdjointPart ℝ A).property
    obtain ⟨t, ht⟩ := hK
    refine ⟨(t, A), ?_⟩
    change L t + (selfAdjointPart ℝ A : M) = A
    change L t = (skewAdjointPart ℝ A : M) at ht
    rw [ht, add_comm]
    exact StarModule.selfAdjointPart_add_skewAdjointPart ℝ A
  have hF0 : ambientProduct P 0 = 1 := by simp [ambientProduct, hP0]
  have hMap := (hFSmooth.hasStrictFDerivAt' hFDeriv one_ne_zero).map_nhds_eq_of_surj hSurj
  rw [hF0] at hMap
  let good := {p : (τ → ℝ) × M | IsUnit (2 + hermitianPart p.2)}
  have hgood : good ∈ 𝓝 (0 : (τ → ℝ) × M) := by
    apply IsOpen.mem_nhds (Units.isOpen.preimage (continuous_const.add L₂.continuous))
    have htwo : IsUnit (2 : M) := by
      have hu := (isUnit_iff_ne_zero.mpr (two_ne_zero : (2 : ℂ) ≠ 0)).map (algebraMap ℂ M)
      rw [map_ofNat] at hu
      exact hu
    change IsUnit (2 + L₂ 0)
    simpa only [map_zero, add_zero] using htwo
  have hIm : ambientProduct P '' good ∈ 𝓝 (1 : M) := by
    have hImage : ambientProduct P '' good ∈ Filter.map (ambientProduct P) (𝓝 0) :=
      Filter.image_mem_map hgood
    exact hMap ▸ hImage
  rw [show 𝓝 (1 : U) = Filter.comap ((↑) : U → M) (𝓝 (1 : M)) from
    nhds_subtype_eq_comap]
  refine Filter.mem_comap.mpr ⟨ambientProduct P '' good, hIm, ?_⟩
  intro F hF
  obtain ⟨⟨t, B⟩, hB, hFB⟩ := hF
  have hz := hermitian_eq_zero_of_unitary (hermitianPart B)
    (selfAdjointPart ℝ B).property hFB.symm hB
  have hEq : F = P t := by
    apply Subtype.ext
    simpa [ambientProduct, hz] using hFB.symm
  rw [hEq]
  exact hPG t

/-- A finite family of smooth curves with spanning unitary tangent
directions yields an identity neighborhood in the subgroup containing
all their values. -/
theorem one_nhds_of_unitaryCurveProducts [Fintype τ] (G : Subgroup U)
    (c : τ → ℝ → U) (hc0 : ∀ i, c i 0 = 1) (hcG : ∀ i t, c i t ∈ G)
    (hSmooth : ∀ i, ContDiffAt ℝ 1 (fun t => (c i t : M)) 0)
    (X : τ → M) (hDeriv : ∀ i, HasDerivAt (fun t => (c i t : M)) (X i) 0)
    (hspan : skewAdjoint.submodule ℝ M ≤ Submodule.span ℝ (Set.range X)) :
    (G : Set U) ∈ 𝓝 1 := by
  classical
  let indices : List τ := Finset.univ.toList
  have hPG (t : τ → ℝ) : curveProduct c indices t ∈ G := by
    apply G.list_prod_mem
    intro v hv
    obtain ⟨i, _, rfl⟩ := List.mem_map.mp hv
    exact hcG i (t i)
  apply productNeighborhood G (curveProduct c indices) (curveProduct_zero c hc0 indices) hPG
    (productDerivative X indices) (curveProduct_contDiffAt c hSmooth indices)
    (curveProduct_hasFDerivAt c hc0 X hDeriv indices)
  intro T hT
  obtain ⟨t, ht⟩ := (Submodule.mem_span_range_iff_exists_fun ℝ).mp (hspan hT)
  refine ⟨t, ?_⟩
  change productDerivative X indices t = T
  rw [productDerivative_apply]
  have hsum := List.sum_toFinset (fun i : τ => t i • X i)
    (Finset.univ : Finset τ).nodup_toList
  simpa only [indices, ← hsum, Finset.toList_toFinset] using ht

/-- Density then gives the entire unitary group. -/
theorem eq_top_of_unitaryCurveProducts [Fintype τ] (G : Subgroup U)
    (hDense : G.topologicalClosure = ⊤)
    (c : τ → ℝ → U) (hc0 : ∀ i, c i 0 = 1) (hcG : ∀ i t, c i t ∈ G)
    (hSmooth : ∀ i, ContDiffAt ℝ 1 (fun t => (c i t : M)) 0)
    (X : τ → M) (hDeriv : ∀ i, HasDerivAt (fun t => (c i t : M)) (X i) 0)
    (hspan : skewAdjoint.submodule ℝ M ≤ Submodule.span ℝ (Set.range X)) :
    G = ⊤ :=
  dense_subgroup_eq_top_of_one_nhds G hDense
    (one_nhds_of_unitaryCurveProducts G c hc0 hcG hSmooth X hDeriv hspan)

/-- An identity neighborhood upstairs descends through the projective
quotient; a dense subgroup admitting such lifts equals the full quotient. -/
theorem projective_eq_top_of_unitaryCurveProducts [Fintype τ]
    (G : Subgroup (PU ι)) (hDense : G.topologicalClosure = ⊤)
    (c : τ → ℝ → U) (hc0 : ∀ i, c i 0 = 1)
    (hcG : ∀ i t, projectiveMk (ι := ι) (c i t) ∈ G)
    (hSmooth : ∀ i, ContDiffAt ℝ 1 (fun t => (c i t : M)) 0)
    (X : τ → M) (hDeriv : ∀ i, HasDerivAt (fun t => (c i t : M)) (X i) 0)
    (hspan : skewAdjoint.submodule ℝ M ≤ Submodule.span ℝ (Set.range X)) :
    G = ⊤ := by
  let Gup := G.comap (projectiveMk (ι := ι))
  have hN := one_nhds_of_unitaryCurveProducts Gup c hc0 hcG hSmooth X hDeriv hspan
  have hopen : IsOpenMap (projectiveMk (ι := ι) : U → PU ι) :=
    QuotientGroup.isOpenMap_coe
  have hImage := hopen.image_mem_nhds hN
  rw [map_one] at hImage
  apply dense_subgroup_eq_top_of_one_nhds G hDense
  apply Filter.mem_of_superset hImage
  rintro y ⟨u, hu, rfl⟩
  exact hu

#print axioms one_nhds_of_unitaryCurveProducts
#print axioms eq_top_of_unitaryCurveProducts
#print axioms projective_eq_top_of_unitaryCurveProducts

end
end CriticalDepth.UnitaryCurveProducts
