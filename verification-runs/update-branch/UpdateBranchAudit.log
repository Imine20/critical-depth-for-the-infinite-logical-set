  2 ≤ d →
    2 ≤ q →
      1 ≤ h →
        have m := CriticalDepth.FaultDepthArithmetic.lowerEnvelope q d h;
        ∃ C,
          CriticalDepth.Manuscript.IsStabilizer C ∧
            CriticalDepth.Manuscript.HasActualDistance C d ∧
              CriticalDepth.FaultHistoryExperimentNormalization.paperPerCodeExponent C q h = ↑m ∧
                CriticalDepth.FaultAverageInfidelity.paperPerCodeAverageExponent C q h = ↑m ∧
                  CriticalDepth.FaultChannelEffects.paperPerCodeDiamondExponent C q h = ↑m ∧
