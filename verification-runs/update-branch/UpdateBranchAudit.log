              CriticalDepth.Manuscript20261114.CSSCode.cssLogicalQubits H J =
                  CriticalDepth.Manuscript20261114.CSSCheckSpaces.cssSites R -
                      CriticalDepth.Manuscript20261114.CSSCheckSpaces.cssXDimension R -
                    CriticalDepth.Manuscript20261114.CSSCheckSpaces.cssZDimension R ∧
                ∀ (h : ℕ),
                  1 ≤ h →
                    h ≤ t →
                      have m :=
                        CriticalDepth.FaultDepthArithmetic.upperEnvelope q
                          (CriticalDepth.Manuscript20261114.CSSCheckSpaces.cssDistance R) h;
                      CriticalDepth.FaultHistoryExperimentNormalization.paperPerCodeExponent C q h = ↑m ∧
