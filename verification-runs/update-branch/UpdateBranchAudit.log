@CriticalDepth.Manuscript20261114.sharpFaultSuppression_bounds_allMetrics : ∀ {n k d q h : ℕ}
  (C : CriticalDepth.Manuscript.Code n (fun x => 2) (2 ^ k) 1),
  CriticalDepth.Manuscript.IsStabilizer C →
    CriticalDepth.Manuscript.HasActualDistance C d →
      2 ≤ d →
        2 ≤ q →
          1 ≤ h →
            have lo := ↑(CriticalDepth.FaultDepthArithmetic.lowerEnvelope q d h);
            have hi := ↑(CriticalDepth.FaultDepthArithmetic.upperEnvelope q d h);
            (lo ≤ CriticalDepth.FaultHistoryExperimentNormalization.paperPerCodeExponent C q h ∧
                CriticalDepth.FaultHistoryExperimentNormalization.paperPerCodeExponent C q h ≤ hi) ∧
              (lo ≤ CriticalDepth.FaultAverageInfidelity.paperPerCodeAverageExponent C q h ∧
                  CriticalDepth.FaultAverageInfidelity.paperPerCodeAverageExponent C q h ≤ hi) ∧
                lo ≤ CriticalDepth.FaultChannelEffects.paperPerCodeDiamondExponent C q h ∧
                  CriticalDepth.FaultChannelEffects.paperPerCodeDiamondExponent C q h ≤ hi
