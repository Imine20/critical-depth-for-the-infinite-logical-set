@CriticalDepth.FaultPointwiseAmbiguity.minWeight_le_optimalCPTPInfidelity_of_ambiguous_pair : ∀ {Phys : Type u_1}
  {Log : Type u_2} [inst : Fintype Phys] [DecidableEq Phys] [inst_2 : Fintype Log] [inst_3 : DecidableEq Log]
  [Nonempty Log] {Hist : Type u_3} [inst_5 : Fintype Hist] [DecidableEq Hist] (A : Hist → Matrix Phys Log ℂ),
  (∀ (x : Hist), (A x).conjTranspose * A x = 1) →
    ∀ (weight : Hist → ℝ),
      (∀ (x : Hist), 0 ≤ weight x) →
        ∀ (x y : Hist),
          x ≠ y →
            ∀ (P : Matrix Log Log ℂ),
              P * P.conjTranspose = 1 →
                P.trace = 0 →
                  ∀ (u : ℂ),
                    ‖u‖ = 1 →
                      A y = u • (A x * P) →
                        min (weight x) (weight y) ≤
                          sInf
                            (Set.range fun L =>
                              ∑ z, weight z * CriticalDepth.FaultCPTPOptimality.channelBranchLoss (A z) ↑L)
