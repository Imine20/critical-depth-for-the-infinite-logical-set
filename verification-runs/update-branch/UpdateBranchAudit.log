@CriticalDepth.FaultFirstBadOrder.paperCircuitErrorExponents_eq_firstUncorrectableOrder : ∀ {n K q : ℕ}
  [Nonempty (Fin K × Fin 1)] (C : CriticalDepth.Manuscript.Code n (fun x => 2) K 1)
  (L : CriticalDepth.FaultHistoryNormalization.PaperLayers)
  (μ : CriticalDepth.IndependentFaultHistories.Law (CriticalDepth.FaultHistoryNormalization.PaperLabel L)),
  have order :=
    CriticalDepth.FaultFirstBadOrder.firstUncorrectableOrder
      (CriticalDepth.FaultHistoryExperimentNormalization.paperEncodedBranch C L);
  CriticalDepth.FaultExponent.exponent
        (CriticalDepth.FaultHistoryExperimentNormalization.paperCircuitInfidelity C L μ) =
      order ∧
    CriticalDepth.FaultExponent.exponent (CriticalDepth.FaultAverageInfidelity.paperCircuitAverageInfidelity C L μ) =
        order ∧
      CriticalDepth.FaultExponent.exponent (CriticalDepth.FaultChannelEffects.paperCircuitDiamond C L μ) = order
