                                        μ =Θ[nhdsWithin 0 (Set.Ioi 0)]
                                      fun p => p ^ m) ∧
                                    CriticalDepth.FaultChannelEffects.paperCircuitDiamond C e.layers
                                        μ =Θ[nhdsWithin 0 (Set.Ioi 0)]
                                      fun p => p ^ m
