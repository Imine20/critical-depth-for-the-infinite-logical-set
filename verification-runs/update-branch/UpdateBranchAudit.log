@CriticalDepth.FaultFirstBadOrder.historyErrors_firstUncorrectableOrder : ∀ {Phys : Type u_1} {Log : Type u_2}
  {Loc : Type u_3} [inst : Fintype Phys] [inst_1 : DecidableEq Phys] [inst_2 : Fintype Log] [inst_3 : DecidableEq Log]
  [Nonempty Log] [inst_5 : Fintype Loc] [inst_6 : DecidableEq Loc] {Label : Loc → Type u_4}
  [inst_7 : (i : Loc) → Fintype (Label i)] [(i : Loc) → DecidableEq (Label i)]
  (μ : CriticalDepth.IndependentFaultHistories.Law Label)
  (A : CriticalDepth.IndependentFaultHistories.History Label → Matrix Phys Log ℂ),
  (∀ (x : CriticalDepth.IndependentFaultHistories.History Label), (A x).conjTranspose * A x = 1) →
    (CriticalDepth.FaultFirstBadOrder.firstUncorrectableOrder A = ⊤ ∧
        ∃ R,
          (∀ (x : CriticalDepth.IndependentFaultHistories.History Label),
              CriticalDepth.FaultCPTPOptimality.recoverBranch (↑R) (A x) = LinearMap.id) ∧
            ∀ (p : ℝ),
              0 ≤ p →
                p ≤ 1 →
                  CriticalDepth.EncodedFaultRecovery.optimalInfidelity μ A p = 0 ∧
                    CriticalDepth.FaultAverageInfidelity.optimalAverageInfidelity μ A p = 0 ∧
                      CriticalDepth.FaultChannelEffects.optimalHistoryDiamond μ A p = 0) ∨
      ∃ m,
        CriticalDepth.FaultFirstBadOrder.firstUncorrectableOrder A = ↑m ∧
          (∀ j < m, CriticalDepth.FaultFirstBadOrder.correctableThrough A j) ∧
            ¬CriticalDepth.FaultFirstBadOrder.correctableThrough A m ∧
              (CriticalDepth.EncodedFaultRecovery.optimalInfidelity μ A =Θ[nhdsWithin 0 (Set.Ioi 0)] fun p => p ^ m) ∧
                (CriticalDepth.FaultAverageInfidelity.optimalAverageInfidelity μ A =Θ[nhdsWithin 0 (Set.Ioi 0)] fun p =>
                    p ^ m) ∧
                  CriticalDepth.FaultChannelEffects.optimalHistoryDiamond μ A =Θ[nhdsWithin 0 (Set.Ioi 0)] fun p =>
                    p ^ m
