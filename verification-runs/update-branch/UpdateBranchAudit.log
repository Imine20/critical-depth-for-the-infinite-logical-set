def CriticalDepth.ReviewV2.NativeTheoremOne : Prop :=
∀ (n K g d : ℕ) (dim : Fin n → ℕ),
  1 ≤ n →
    2 ≤ K →
      1 ≤ g →
        2 ≤ d →
          ∀ (V : Matrix (CriticalDepth.Manuscript.PhysicalBasis n dim) (Fin K × Fin g) ℂ),
            V.conjTranspose * V = 1 →
              CriticalDepth.ReviewV2.NativeDetectsBelow V d →
                ∀ (q h : ℕ),
                  2 ≤ q →
                    1 ≤ h →
                      h < CriticalDepth.Arithmetic.criticalDepth q d →
                        (CriticalDepth.ReviewV2.nativeLogicalImage V q h).Finite ∧
                          ¬Dense (CriticalDepth.ReviewV2.nativeLogicalImage V q h)
def CriticalDepth.ReviewV2.StandardTheoremTwo : Prop :=
∀ (n k d q : ℕ),
  1 ≤ k →
    2 ≤ d →
      2 ≤ q →
        ∀ (V : Matrix (CriticalDepth.Manuscript.QubitBasis n) (Fin (2 ^ k) × Fin 1) ℂ),
          V.conjTranspose * V = 1 →
            CriticalDepth.ReviewV2.StandardStabilizerCode V →
              CriticalDepth.ReviewV2.NativeActualDistance V d →
                CriticalDepth.ReviewV2.nativeCriticalDepth V q = ↑(CriticalDepth.Arithmetic.criticalDepth q d) ∧
                  ∃ S,
                    IsClosed ↑S ∧
                      S ≠ ⊥ ∧
                        Nonempty (Circle ≃ₜ* ↥S) ∧
                          ↑S ⊆
                            CriticalDepth.ReviewV2.nativeLogicalImage V q (CriticalDepth.Arithmetic.criticalDepth q d)
